# Legacy fallback only; preferred flow is encrypted Settings.
PUBLIC_API_SECRET=
# Login-only secret used to establish a host-only secure session cookie. Never commit the real value.
EDGE_APP_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ENABLE_LIVE_ORDERS=false
PORT=8787

# Optional OpenAI analysis (off by default): configure as private hosting secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Required for encrypted Public API credential saving in Settings. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set only in Render's private Environment settings; never commit the real value.
EDGE_CREDENTIAL_KEY=

# Default off: only after separate owner bootstrap, verified recovery and private file.
# This gate never places orders or enables a Public API read by itself.
EDGE_PERMANENT_READONLY_PILOT_ENABLED=false
